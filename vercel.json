{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/sorting", "permanent": true },
    { "source": "/home.html", "destination": "/", "permanent": true },
    { "source": "/sorting/", "destination": "/sorting", "permanent": true },
    { "source": "/fractals.html", "destination": "/fractals", "permanent": true },
    { "source": "/fractals/", "destination": "/fractals", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/sorting", "destination": "/index.html" },
    { "source": "/fractals", "destination": "/fractals.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
